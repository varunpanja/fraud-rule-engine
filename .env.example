# ==========================================
# Fraud Rule Engine Configuration
# ==========================================

# Database Configuration (SQLite default for simple local setup)
DATABASE_URL=sqlite:///./fraud_engine.db

# Fraud Rule Thresholds
VELOCITY_WINDOW_MINUTES=5
VELOCITY_MAX_TRANSACTIONS=5
UNUSUAL_AMOUNT_THRESHOLD=100000
MAX_REALISTIC_SPEED_KMPH=900
HIGH_RISK_THRESHOLD=70

# AWS SNS Notification Configuration (Optional for local development)
# If left blank, high-risk notifications will be logged to console in local fallback mode.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SNS_TOPIC_ARN=
